{
  "lastChangelogVersion": "1.6.0",
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultTools": [
    "read",
    "powershell",
    "edit",
    "write"
  ],
  "theme": "cc-dark-hc",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-cc-extensions",
    "npm:@juicesharp/rpiv-todo",
    "npm:planning-with-files"
  ],
  "retry": {
    "enabled": true,
    "maxRetries": 8,
    "baseDelayMs": 10000,
    "provider": {
      "maxRetryDelayMs": 120000
    }
  },
  "compaction": {
    "enabled": false
  },
  "httpProxy": "http://127.0.0.1:7897",
  "hideThinkingBlock": false,
  "showCacheMissNotices": false,
  "quietStartup": true,
  "tuiMode": "fullscreen",
  "markdown": {
    "mermaid": "final"
  },
  "defaultProvider": "墨析AI",
  "defaultModel": "deepseek-v4.1-flash",
  "fullscreenCopyOnSelect": false,
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-cc-extensions\",\"scope\":\"user\"}": "1.0.21"
  }
}